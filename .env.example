# Copy to .env for local Docker Compose. Use URL-safe values for passwords.
COMPOSE_PROJECT_NAME=investiq
APP_ENV=development
HTTP_PORT=8080
LOG_VIEWER_PORT=9999
LOG_LEVEL=INFO

POSTGRES_DB=investiq
POSTGRES_USER=investiq
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
REDIS_PASSWORD=replace-with-a-strong-url-safe-password
SECRET_KEY=replace-with-at-least-32-random-characters

CELERY_CONCURRENCY=2
NEWS_INGESTION_ENABLED=false
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_LOG_VIEWER_URL=http://localhost:9999

# CI/CD overrides these with immutable GHCR image tags.
BACKEND_IMAGE=investiq-backend:local
FRONTEND_IMAGE=investiq-frontend:local
