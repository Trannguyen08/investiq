# Copy to .env for local Docker Compose. Use URL-safe values for passwords.
COMPOSE_PROJECT_NAME=investiq
APP_ENV=development
HTTP_PORT=8080
LOG_VIEWER_PORT=9999
LOG_LEVEL=INFO

POSTGRES_DB=investiq
POSTGRES_USER=investiq
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
REDIS_PASSWORD=replace-with-a-strong-url-safe-password
SECRET_KEY=replace-with-at-least-32-random-characters

CELERY_CONCURRENCY=2
NEWS_INGESTION_ENABLED=true
NEWS_INGESTION_MAX_AGE_HOURS=2160
NEWS_RETENTION_DAYS=90
NEWS_PROVIDER_REQUESTS_PER_MINUTE=30
NEWS_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
NEWS_PROVIDER_CIRCUIT_OPEN_SECONDS=120
# Market data is fail-closed. Use fixture only for local UI/API development.
# Vnstock is a source-delayed connector for evaluation; its software key does not grant
# third-party redistribution rights for the upstream data sources.
MARKET_DATA_MODE=disabled
MARKET_PUBLIC_CACHE_SECONDS=30
VNSTOCK_API_KEY=
VNSTOCK_REFRESH_SECONDS=60
VNSTOCK_CANDLE_CACHE_SECONDS=300
VNSTOCK_FUNDAMENTAL_CACHE_SECONDS=3600
VNSTOCK_MAX_SYMBOLS=1800
# TCBS mode accepts either a pre-issued access token, or API key + one-time Smart OTP.
# TCBS has no documented refresh token; replace the token/OTP and restart before expiry.
TCBS_API_KEY=
TCBS_OTP=
TCBS_ACCESS_TOKEN=
TCBS_API_BASE_URL=https://openapi.tcbs.com.vn
TCBS_WS_URL=wss://openapi.tcbs.com.vn/ws/thesis/v1/stream/normal
TCBS_REQUEST_TIMEOUT_SECONDS=5
TCBS_QUOTE_REFRESH_SECONDS=3
TCBS_SECURITY_REFRESH_SECONDS=21600
TCBS_HTTP_RETRY_ATTEMPTS=3
TCBS_CIRCUIT_FAILURE_THRESHOLD=5
TCBS_CIRCUIT_OPEN_SECONDS=30
# NEWS_ADMIN_TOKEN=replace-with-a-dedicated-random-operations-token
# ADMIN_UI_PASSWORD=replace-with-a-dedicated-admin-password
# ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_LOG_VIEWER_URL=http://localhost:9999

# Authentication stays fail-closed until all required secrets are configured.
AUTH_ENABLED=false
AUTH_BFF_SECRET=
AUTH_JWT_SECRET=
AUTH_JWT_PREVIOUS_SECRET=
AUTH_OTP_HMAC_KEY=
AUTH_PAYLOAD_ENCRYPTION_KEY=
AUTH_SESSION_DAYS=30
AUTH_SESSION_REDIS_URL=
AUTH_SESSION_ENCRYPTION_KEY=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/auth-api/google/callback
AUTH_MAIL_FROM=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_STARTTLS=true

# CI/CD overrides these with immutable GHCR image tags.
BACKEND_IMAGE=investiq-backend:local
FRONTEND_IMAGE=investiq-frontend:local
