# Copy to .env for local Docker Compose or Bare-Metal development.
# Use URL-safe values for passwords.

# Local development runtime
COMPOSE_PROJECT_NAME=investiq
COMPOSE_PROFILES=development
FRONTEND_PORT=3000
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=INFO
LOG_VIEWER_PORT=9999

# API Endpoints & Cross-Origin
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_BASE_URL=http://localhost:8000/api
INTERNAL_API_URL=http://localhost:8000/api
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Security
AUTH_ENABLED=false
AUTH_BFF_SECRET=
AUTH_JWT_SECRET=
AUTH_JWT_PREVIOUS_SECRET=
AUTH_OTP_HMAC_KEY=
AUTH_PAYLOAD_ENCRYPTION_KEY=
AUTH_SESSION_DAYS=30
AUTH_SESSION_REDIS_URL=
AUTH_SESSION_ENCRYPTION_KEY=

# Google OAuth
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/auth-api/google/callback

# Email / SMTP
AUTH_MAIL_FROM=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_STARTTLS=true

# Database & Cache
DATABASE_URL=
POSTGRES_DB=investiq
POSTGRES_USER=investiq
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
SECRET_KEY=

# Background Jobs & Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=2
NEWS_INGESTION_ENABLED=true
NEWS_INGESTION_MAX_AGE_HOURS=2160
NEWS_RETENTION_DAYS=90
NEWS_PROVIDER_REQUESTS_PER_MINUTE=30
NEWS_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
NEWS_PROVIDER_CIRCUIT_OPEN_SECONDS=120

# Market Data
MARKET_DATA_MODE=disabled
MARKET_PUBLIC_CACHE_SECONDS=30
VNSTOCK_API_KEY=
FHSC_API_KEY=
VNSTOCK_REFRESH_SECONDS=60
VNSTOCK_CANDLE_CACHE_SECONDS=300
VNSTOCK_FUNDAMENTAL_CACHE_SECONDS=3600
VNSTOCK_MAX_SYMBOLS=1800

# Admin Console & Ops
ADMIN_UI_PASSWORD=
ADMIN_SESSION_SECRET=
NEWS_ADMIN_TOKEN=

# AI & External Cloud Services
RENDER_API_KEY=
GEMINI_API_KEY=

# Cloud Deployment (Vercel, Render, Neon, Upstash)
AUTO_MIGRATE=false
VERCEL_URL=
UPSTASH_REDIS_URL=

# Container Image Tags (CI/CD)
BACKEND_IMAGE=investiq-backend:local
FRONTEND_IMAGE=investiq-frontend:local
